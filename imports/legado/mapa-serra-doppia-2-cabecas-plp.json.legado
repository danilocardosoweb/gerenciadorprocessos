    "clean-shutdown": {
      "description": "Ao terminar o lote ou turno, pare e desligue a máquina conforme o procedimento, remova cavacos somente em condição segura, limpe apoios e referências, organize instrumentos e deixe a área pronta para o próximo uso.",
      "images": [],
      "tasks": [
        {
          "id": "clean-shutdown-1",
          "text": "Conferir: Limpar, desligar e organizar",
          "completed": false
        },
        {
          "id": "clean-shutdown-2",
          "text": "Registrar ou comunicar qualquer desvio encontrado",
          "completed": false
        }
      ],
      "howTo": [
        {
          "order": 1,
          "instruction": "Conclua o último ciclo e confirme que os discos pararam."
        },
        {
          "order": 2,
          "instruction": "Desligue ou isole a energia conforme o procedimento aplicável."
        },
        {
          "order": 3,
          "instruction": "Remova cavacos com ferramenta adequada; nunca use as mãos."
        },
        {
          "order": 4,
          "instruction": "Limpe apoios, referências e área ao redor da máquina."
        },
        {
          "order": 5,
          "instruction": "Guarde instrumentos e informe qualquer anomalia pendente."
        }
      ],
