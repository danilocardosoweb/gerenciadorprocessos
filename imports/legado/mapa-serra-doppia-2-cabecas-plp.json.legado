  "node_details": {
    "root": {
      "description": "Instrução visual para preparar, regular, operar e finalizar cortes do perfil de alumínio TR-0073 na Serra Doppia de 2 cabeças. Consolida 17 instruções de trabalho PLP em um único fluxo seguro, rastreável e fácil de consultar.",
      "images": [],
      "tasks": [
        {
          "id": "root-1",
          "text": "Ler a OP e selecionar o item correto na matriz",
          "completed": false
        },
        {
          "id": "root-2",
          "text": "Cumprir a inspeção de segurança e executar peça piloto",
          "completed": false
        },
        {
          "id": "root-3",
          "text": "Liberar produção somente após conformidade dimensional e visual",
          "completed": false
        },
        {
          "id": "root-4",
          "text": "Embalar, identificar, registrar e finalizar a área",
          "completed": false
        }
      ],
